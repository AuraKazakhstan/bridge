# bridge — PROD: все апстримы WERP на 192.168.0.15.
#
# Один деплой = одно окружение (решение 2026-07-11). Старый PHP-мост мешал
# stage и prod в одном инстансе (Kassa24/формы → prod, Aitu/Mobile → stage) —
# это НЕ переносится: prod-мост целиком смотрит на prod.
# Все переменные без значения обязательны — мост не стартует без них.

BRIDGE_LISTEN_ADDR=:8080

# --- Апстримы WERP (prod, 192.168.0.15) ---
WERP_AUTH_URL=http://192.168.0.15:30001
WERP_CORE_URL=http://192.168.0.15:30002
WERP_SERVICE_URL=http://192.168.0.15:30003
WERP_CRM_URL=http://192.168.0.15:30007

# --- Внешние апстримы (мост как egress) ---
# ПКБ: боевое бюро (дефолта в коде нет — окружение задаётся только здесь)
PKB_URL=https://secure2.1cb.kz/pcr
TWILIO_URL=https://api.twilio.com

# Приёмник входящих сообщений Twilio (полный URL; жив, сохраняется)
TWILIO_RECEIVE_FORWARD_URL=http://192.168.0.215:32002/api/messages/receive

# --- ПЕРЕХОДНЫЙ режим (удаляется после правок в core, задачник в легаси-репо target-bridge) ---
# Сервисный аккаунт: токен запрашивается на каждый запрос, нигде не кэшируется.
# Эти же клиентские креды использует легаси POST /token (Aitu).
WERP_OAUTH_CLIENT_ID=
WERP_OAUTH_CLIENT_SECRET=
WERP_SERVICE_USERNAME=
WERP_SERVICE_PASSWORD=

# --- Kassa24 ---
KASSA24_STATIC_TOKEN=
# через запятую; пусто = проверка IP выключена
KASSA24_ALLOWED_IPS=

# --- Сеть ---
# Доверенные reverse-прокси (nginx перед мостом): ТОЛЬКО их заголовкам
# X-Real-Ip/X-Forwarded-For мост верит при определении клиентского IP.
# CIDR или одиночные IP через запятую. Пусто = заголовки игнорируются.
BRIDGE_TRUSTED_PROXIES=127.0.0.1,::1

# --- Тюнинг ---
BRIDGE_UPSTREAM_TIMEOUT=30s
# лимит тела входящего запроса (байт), 0 = без лимита
BRIDGE_MAX_BODY_BYTES=10485760
# rate limit на клиентский IP; Kassa24 и партнёрские вебхуки вне лимита
BRIDGE_RATE_LIMIT_RPS=20
BRIDGE_RATE_LIMIT_BURST=40
BRIDGE_KG_SCHEDULE_RATE_PER_MIN=5
BRIDGE_KG_SCHEDULE_RATE_BURST=5
